# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me
WEB_PORT=8080
BACKUP_RETENTION_DAYS=14

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_SECRET_KEY=change-me
# Public URL people use to open the CRM (no trailing slash)
CRM_APP_URL=https://crm.metricshub.com
CRM_CORS_ORIGINS=https://crm.metricshub.com

# First administrator (created only when the user table is empty)
CRM_ADMIN_EMAIL=razeem@metricshub.com
CRM_ADMIN_NAME=Razeem Mohamed
CRM_ADMIN_PASSWORD=change-me-now

# ---- Single sign-on (Microsoft Entra ID / any OpenID Connect provider) ----
# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
CRM_OIDC_ISSUER=
CRM_OIDC_CLIENT_ID=
CRM_OIDC_CLIENT_SECRET=
CRM_OIDC_BUTTON_LABEL=Sign in with Microsoft
# Domains whose users get an account automatically on first SSO sign-in (comma-separated; empty = invite only)
CRM_OIDC_AUTO_PROVISION_DOMAINS=metricshub.com,sentrysoftware.com
CRM_OIDC_DEFAULT_ROLE=sales
# Set to false once SSO works to force everyone through SSO
CRM_PASSWORD_LOGIN_ENABLED=true

CRM_RENEWAL_LEAD_DAYS=120

# ---- Sending email (see README "Sending email") ----
# Quotes and notifications: disabled | smtp | graph (Microsoft 365) | log (keep messages on the server, send nothing)
CRM_MAIL_BACKEND=disabled
# Campaigns and newsletters: empty = same as CRM_MAIL_BACKEND
CRM_BULK_MAIL_BACKEND=
CRM_BULK_RATE_PER_MINUTE=120
# SMTP server or relay (Brevo, SendGrid, Amazon SES, smtp.office365.com, your own...)
CRM_SMTP_HOST=
CRM_SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
CRM_SMTP_SECURITY=starttls
CRM_SMTP_USERNAME=
CRM_SMTP_PASSWORD=
# Sender name, and the postal address printed in campaign footers (anti-spam laws)
CRM_MAIL_FROM_NAME=
CRM_MARKETING_POSTAL_ADDRESS=
# Microsoft 365 (graph) settings:
# Empty = tenant from CRM_OIDC_ISSUER. Two tenants: metricshub.com=<tenant-id>,sentrysoftware.com=<tenant-id>
CRM_GRAPH_TENANT_ID=
# Only for an app registration other than the SSO one
CRM_GRAPH_CLIENT_ID=
CRM_GRAPH_CLIENT_SECRET=
# Sender address: required for SMTP and for campaigns; with graph, optional shared mailbox for quotes
CRM_MAIL_FROM=

# ---- Website forms ----
# Proxies in front of the API that add to X-Forwarded-For: 1 = the web container's nginx, 2 with Caddy / a load balancer
CRM_PROXY_HOPS=1

# ---- Licence renewals ----
# Notify the account / renewal opportunity owner this many days before a licence renews
CRM_RENEWAL_NOTICE_DAYS=60
# false = run "python -m app.jobs renewals" from cron instead of inside the API
CRM_RUN_SCHEDULER=true

# ---- Monitoring (MetricsHub, Prometheus) ----
# Lets a monitoring tool read /api/monitoring/status and /api/metrics without a user account.
# Generate with: openssl rand -hex 32   (empty = administrators only)
CRM_MONITORING_TOKEN=

# ---- Freshsales migration (only for the API sync command; remove after cut-over) ----
# Freshsales > Profile settings > API settings: bundle alias (e.g. metricshub) and your API key
CRM_FRESHSALES_DOMAIN=
CRM_FRESHSALES_API_KEY=
